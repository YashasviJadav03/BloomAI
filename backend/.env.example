# BloomAI Backend — Environment Variables
# Copy this file to .env and fill in values as needed.
# NEVER commit a file containing real secrets.

# ── AI / LLM Settings (Google Gemini) ─────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
# Leave GEMINI_API_KEY empty (or unset) to run in template-only mode.
# The app is fully functional without an API key — all responses use curated
# child-safe templates.
GEMINI_API_KEY=

# Which Gemini model to use (default: gemini-2.0-flash — fast and free-tier friendly)
AI_MODEL=gemini-2.0-flash

# Per-request timeout in seconds (default: 4)
AI_TIMEOUT_SECONDS=4

# Maximum characters allowed in a validated AI message (default: 240)
AI_MAX_CHARS=240

# Set to "false" to force template-only mode even when a key is present
AI_ENABLED=true

# ── Database ───────────────────────────────────────────────────────────────
# Default is SQLite (development). Override for production Postgres etc.
# DATABASE_URL=postgresql://user:pass@localhost/bloomai

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed by the CORS middleware.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
