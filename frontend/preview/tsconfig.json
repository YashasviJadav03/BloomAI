{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "recharts": [
        "node_modules/recharts"
      ],
      "vitest": [
        "node_modules/vitest"
      ],
      "@testing-library/react": [
        "node_modules/@testing-library/react"
      ]
    }
  },
  "include": [
    "main.tsx",
    "../src/features"
  ]
}